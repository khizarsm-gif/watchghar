# Copy to .env.local for local development. In Vercel, add the same names under
# Project Settings -> Environment Variables. NEVER commit real values.

# Supabase project (Project Settings -> API). The URL and anon key are public by design.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SECRET. Server only. Never prefix with NEXT_PUBLIC_. Used to save orders and manage staff accounts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (no trailing slash). Update once you have a domain.
NEXT_PUBLIC_SITE_URL=https://watchghar.example.com

# New-order email alerts (Brevo transactional email). All three are SECRET/server only.
# If any is missing, orders still save; the email is simply skipped.
BREVO_API_KEY=your-brevo-api-key
ORDER_NOTIFY_EMAIL=owner@example.com
ORDER_FROM_EMAIL=orders@example.com
